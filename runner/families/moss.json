{
  "family": "moss",
  "label": "MOSS Image",
  "mediaType": "image",
  "model": {
    "name": "MOSS Image",
    "does": "Affiches, mises en page, texte dans l’image.",
    "group": "image",
    "order": 2,
    "version": "SFT"
  },
  "tasks": ["create_image"],
  "engine": "internal",
  "hardware": { "cuda": true },
  "requires": ["torch", "diffusers", "transformers", "accelerate", "safetensors", "PIL", "comfy_kitchen"],
  "components": {
    "model": {
      "label": "Modèle",
      "folder": "diffusion_models",
      "required": true,
      "note": "MOSS Image SFT, par exemple mossImage_sft_pruned_int8.safetensors.",
      "signature": [
        {
          "key": "^(?:model\\.diffusion_model\\.|diffusion_model\\.)?text_embedder\\.proj\\.weight$",
          "shape": [null, 4096]
        }
      ]
    },
    "textEncoder": {
      "label": "Encodeur de texte",
      "folder": "text_encoders",
      "required": true,
      "note": "L’encodeur de MOSS Image, un Qwen3.5-9B (par exemple mossImage_sft_txt_int8.safetensors), et non le modèle MOSS Image lui-même.",
      "signature": [
        {
          "key": "(?:^|\\.)embed_tokens\\.weight$",
          "shape": [null, 4096]
        }
      ]
    },
    "tokenizer": {
      "label": "Tokenizer",
      "folder": "text_encoders",
      "required": true,
      "format": "tokenizer",
      "policies": ["fixed"],
      "picker": "tokenizer",
      "vocabularyOf": "textEncoder",
      "help": "Dossier qui découpe le prompt en tokens pour l’encodeur de texte (qwen35_tokenizer : tokenizer_config.json, tokenizer.json). Proposé automatiquement d’après l’encodeur."
    },
    "vae": {
      "label": "VAE",
      "folder": "vae",
      "required": true,
      "note": "flux2-vae.safetensors",
      "signature": [
        {
          "key": "^encoder\\.conv_in\\.weight$",
          "shape": [null, 3, 3, 3]
        },
        {
          "key": "^decoder\\.conv_in\\.weight$",
          "shape": [null, 32, 3, 3]
        }
      ]
    }
  },
  "parameters": {
    "prompt": {
      "type": "string",
      "maxLength": 8000,
      "nonempty": true
    },
    "negative_prompt": {
      "type": "string",
      "maxLength": 8000
    },
    "seed": {
      "type": "integer",
      "min": 0,
      "max": 9007199254740991
    },
    "width": {
      "type": "integer",
      "min": 256,
      "max": 4096,
      "multipleOf": 16
    },
    "height": {
      "type": "integer",
      "min": 256,
      "max": 4096,
      "multipleOf": 16
    },
    "steps": {
      "type": "integer",
      "min": 1,
      "max": 200
    },
    "cfg": {
      "type": "number",
      "min": 1,
      "max": 20
    },
    "shift": {
      "type": "number",
      "min": 1,
      "max": 12,
      "note": "Répartit les étapes entre la composition d’ensemble (plus haut) et les détails (plus bas) ; 5 est la valeur du modèle."
    },
    "attention": {
      "type": "string",
      "choices": ["pytorch", "comfy_kitchen"],
      "note": "Attention dense : comfy_kitchen calcule en INT8 (plus rapide, à peine différent), pytorch exactement.",
      "unused": "Sans effet : le moteur de Moodix prend l’attention que le fichier du modèle demande (ce réglage servait à ComfyUI)."
    }
  },
  "requiredParameters": ["prompt", "seed", "width", "height", "steps", "cfg"],
  "implicitParameters": {
    "negative_prompt": "",
    "shift": 5
  },
  "roles": {},
  "template": {
    "name": "MOSS Image",
    "description": "Create an image with MOSS Image, strong at layouts, posters and text written in the picture.",
    "components": {
      "model": {
        "policy": "fixed",
        "asset": "select-local-model"
      },
      "textEncoder": {
        "policy": "fixed",
        "asset": "select-local-text-encoder"
      },
      "tokenizer": {
        "policy": "fixed",
        "asset": "select-local-tokenizer"
      },
      "vae": {
        "policy": "fixed",
        "asset": "select-local-vae"
      }
    },
    "parameters": {
      "prompt": {
        "policy": "model",
        "type": "string",
        "maxLength": 8000
      },
      "negative_prompt": {
        "policy": "fixed",
        "value": ""
      },
      "seed": {
        "policy": "random",
        "type": "integer"
      },
      "width": {
        "policy": "fixed",
        "value": 1024
      },
      "height": {
        "policy": "fixed",
        "value": 1024
      },
      "steps": {
        "policy": "fixed",
        "value": 50
      },
      "cfg": {
        "policy": "fixed",
        "value": 3
      },
      "shift": {
        "policy": "fixed",
        "value": 5
      }
    },
    "loras": [],
    "references": []
  },
  "chooseFor": "a poster, a page layout, or text written in the picture"
}
