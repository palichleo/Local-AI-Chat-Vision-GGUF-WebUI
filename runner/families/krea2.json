{
  "family": "krea2",
  "label": "Krea2",
  "mediaType": "image",
  "tasks": ["create_image"],
  "engine": "external",
  "hardware": { "cuda": true, "vramGiB": 10 },
  "selectable": true,
  "requires": ["torch", "diffusers", "transformers", "accelerate", "safetensors", "PIL", "comfy_kitchen"],
  "components": {
    "model": {
      "label": "Modèle",
      "folder": "diffusion_models",
      "required": true,
      "signature": [
        {
          "key": "^(?:model\\.diffusion_model\\.|diffusion_model\\.)?first\\.weight$",
          "shape": [6144, 64]
        },
        {
          "key": "^(?:model\\.diffusion_model\\.|diffusion_model\\.)?blocks\\.\\d+\\.attn\\.wq\\.weight$",
          "shape": [6144, 6144]
        }
      ]
    },
    "textEncoder": {
      "label": "Encodeur de texte",
      "folder": "text_encoders",
      "required": true,
      "signature": [
        {
          "key": "^(?:model\\.)?embed_tokens\\.weight$",
          "shape": [null, 2560]
        }
      ]
    },
    "tokenizer": {
      "label": "Tokenizer",
      "folder": "text_encoders",
      "required": false,
      "format": "tokenizer",
      "policies": ["fixed"],
      "picker": "tokenizer",
      "vocabularyOf": "textEncoder",
      "help": "Dossier du tokenizer de l’encodeur de texte. Facultatif : ComfyUI, qui génère les images Krea 2, a le sien."
    },
    "vae": {
      "label": "VAE",
      "folder": "vae",
      "required": true,
      "signature": [
        {
          "key": "^encoder\\.conv1\\.weight$",
          "shape": [null, 3, null, null, null]
        },
        {
          "key": "^decoder\\.conv1\\.weight$",
          "shape": [null, 16, null, null, null]
        }
      ]
    }
  },
  "parameters": {
    "prompt": {
      "type": "string",
      "maxLength": 8000,
      "nonempty": true
    },
    "seed": {
      "type": "integer",
      "min": 0,
      "max": 9007199254740991
    },
    "width": {
      "type": "integer",
      "min": 64,
      "max": 4096,
      "multipleOf": 8
    },
    "height": {
      "type": "integer",
      "min": 64,
      "max": 4096,
      "multipleOf": 8
    },
    "steps": {
      "type": "integer",
      "min": 1,
      "max": 1000
    },
    "cfg": {
      "type": "number",
      "choices": [1]
    },
    "denoise": {
      "type": "number",
      "min": 0,
      "max": 1,
      "exclusiveMin": true
    },
    "expandPrompt": {
      "type": "boolean"
    },
    "attention": {
      "type": "string",
      "choices": ["pytorch", "comfy_kitchen"],
      "note": "Attention dense : comfy_kitchen calcule en INT8 (plus rapide, à peine différent), pytorch exactement."
    }
  },
  "requiredParameters": ["prompt", "seed", "width", "height", "steps"],
  "implicitParameters": {
    "cfg": 1,
    "denoise": 1
  },
  "roles": {
    "img2img": {
      "as": "source",
      "media": "image",
      "max": 1,
      "label": "Image à modifier"
    }
  },
  "loras": {
    "max": 32,
    "strength": {
      "type": "number",
      "min": -4,
      "max": 4
    },
    "signature": [
      {
        "key": "(?:^|\\.)lora_A\\.weight$",
        "shape": [null, null]
      },
      {
        "key": "(?:^|\\.)lora_B\\.weight$",
        "shape": [null, null]
      }
    ]
  },
  "features": ["promptTemplate", "promptExpansion"],
  "promptExpansionDefault": {
    "template": "Rewrite the following image request as one detailed English prompt for the Krea 2 image model. Keep every subject, object, text, style and constraint that is asked for, and only add fitting concrete details: composition, framing, lighting, colors, materials, setting and atmosphere. Answer with the prompt paragraph only, without title, list or commentary.\n\nRequest: {{prompt}}",
    "maxTokens": 320,
    "temperature": 0.5,
    "topK": 64,
    "topP": 0.95,
    "minP": 0.05,
    "repetitionPenalty": 1.05,
    "seed": 0,
    "suffix": ""
  },
  "template": {
    "name": "Krea2 image",
    "description": "Create or edit an image with the selected local Krea2 assets.",
    "components": {
      "model": {
        "policy": "fixed",
        "asset": "select-local-model"
      },
      "textEncoder": {
        "policy": "fixed",
        "asset": "select-local-text-encoder"
      },
      "tokenizer": {
        "policy": "fixed",
        "asset": "select-local-tokenizer"
      },
      "vae": {
        "policy": "fixed",
        "asset": "select-local-vae"
      }
    },
    "parameters": {
      "prompt": {
        "policy": "model",
        "type": "string",
        "maxLength": 8000
      },
      "seed": {
        "policy": "random",
        "type": "integer"
      },
      "width": {
        "policy": "fixed",
        "value": 1024
      },
      "height": {
        "policy": "fixed",
        "value": 1024
      },
      "steps": {
        "policy": "fixed",
        "value": 8
      },
      "cfg": {
        "policy": "fixed",
        "value": 1
      },
      "denoise": {
        "policy": "fixed",
        "value": 1
      },
      "expandPrompt": {
        "policy": "fixed",
        "value": false
      },
      "attention": {
        "policy": "fixed",
        "value": "pytorch"
      }
    },
    "loras": [],
    "references": [
      {
        "id": "source",
        "name": "Source image",
        "role": "img2img",
        "description": "Optional image to edit.",
        "required": false
      }
    ]
  },
  "preference": 1
}
