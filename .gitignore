output/
workflow/*.json
runner/**/__pycache__/
runner/__pycache__/
runner/**/*.pyc

# Built-in engines set aside when ComfyUI took their families over: kept on disk, out of the repository.
experiment_keep_engine/

# Working notes and assistant instructions: kept on this machine, out of the repository.
doc/
CLAUDE.md

# Design files from the user (favicon, marks, design notes): copies are in public/; kept out of the repository.
claude_design/
